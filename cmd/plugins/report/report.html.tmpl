    <div class="who">GLIMPS <span>Malware · Rapport de session</span></div>
    <div class="when">Début : {{ .ScanStartTime }}<br>Durée de session : {{ .Duration }}</div>
</div>

{{ $cls := " ok" }}
{{ $title := "Aucune menace détectée" }}
{{ $detail := "Aucun comportement suspect ou malveillant n'a été détecté dans les fichiers soumis." }}
{{ if gt .TotalMitigated 0 }}
{{ $cls = "" }}
{{ $title = printf "%d fichier(s) bloqué(s)" .TotalMitigated }}
{{ $detail = "Un ou plusieurs fichiers ont été bloqués par les moteurs d'analyse." }}
{{ else if or (gt .TotalErrors 0) (gt .NbFileNotAnalyzed 0) }}
{{ $cls = " warn" }}
{{ $title = "Analyse incomplète" }}
{{ $detail = "Aucun fichier n'a été bloqué, mais des fichiers sont en erreur ou n'ont pas été analysés (voir les rubriques ci-dessous)." }}
{{ end }}
<div class="verdict{{ $cls }}" id="conclusion">
    <p class="kicker">Conclusion</p>
    <h1>{{ $title }}</h1>
    <p>{{ $detail }}</p>
    <p>Seuls les fichiers analysés comme sains ont pu être déplacés par l'application sur le support de destination.</p>
</div>
<p class="scan">Analyse {{ .ScanID }}</p>

<div class="tiles" id="analysis-details">
    <div class="tile bad"><p class="n">{{ .TotalMitigated }}</p><p class="l">Bloqués</p></div>
    <div class="tile mal"><p class="n">{{ .TotalMalware }}</p><p class="l">Fichiers malveillants</p></div>
    <div class="tile warn"><p class="n">{{ .NbFileNotAnalyzed }}</p><p class="l">Non analysés</p></div>
    <div class="tile err"><p class="n">{{ .TotalErrors }}</p><p class="l">Fichiers en erreur</p></div>
</div>

<div class="facts">
    <div class="fact"><p class="k">Fichiers listés</p><p class="v">{{ .NbFileSubmitted }}</p></div>
    <div class="fact"><p class="k">Fichiers analysés</p><p class="v">{{ .NbFileAnalyzed }}</p></div>
    <div class="fact"><p class="k">Taille totale (avant extraction)</p><p class="v">{{ .FileVolume }}</p></div>
    <div class="fact"><p class="k">Volume analysé</p><p class="v">{{ .AnalyzedVolume }}</p></div>
    <div class="fact"><p class="k">Volume filtré</p><p class="v">{{ .FilteredVolume }}</p></div>
</div>
<p class="scan">Non analysés : membres d'archives inclus.</p>

{{ if gt .NbFileNotAnalyzed 0 }}
<p class="note">Des fichiers non analysés (voir la rubrique « Fichiers non analysés ») ont pu être transmis sans analyse complète, selon la politique choisie (<code>unanalyzable_policy</code>) : leur contenu n'a pas été vérifié.</p>
{{ end }}

{{ if gt (len .MitigatedFiles) 0 }}
<section id="threat-files">
    <h2 class="bad">Fichiers bloqués<span class="count">{{ add (len .MitigatedFiles) .MoreMitigatedFiles }}</span></h2>
    <table>
        {{ template "findingHead" (mergeArgsIntoSlice "Chemin" "Analyse") }}
        <tbody>
            {{ range .MitigatedFiles }}
            <tr>
                {{ template "findingCells" (mergeArgsIntoSlice . 0) }}
            </tr>
            {{ end }}
        </tbody>
    </table>
    {{ if gt .MoreMitigatedFiles 0 }}<p class="more">… et {{ others .MoreMitigatedFiles "" "" }}</p>{{ end }}
</section>
{{ end }}

{{ if gt (len .MitigatedArchives) 0 }}
<section id="threat-archive">
    <h2 class="bad">Archives bloquées<span class="count">{{ add (len .MitigatedArchives) .MoreMitigatedArchives }}</span></h2>
    {{ range $index, $file := .MitigatedArchives }}
    <div class="archive" id="threat-archive-{{ $index }}">
        <h3>Archive {{ .Name }}</h3>
        <p class="meta"><b>Nombre de sous-fichier extrait :</b> {{ .FileCount }} · <b>Taille :</b> {{ .Size }} · <b>Quarantaine :</b> {{ .QuarantineLocation }}<br><b>SHA-256 :</b> <code>{{ .SHA256 }}</code></p>
        <table>
            {{ template "findingHead" (mergeArgsIntoSlice "Nom" "URL de l'analyse") }}
            <tbody>
                {{ template "extractedFilesRows" (mergeArgsIntoSlice .ExtractedFiles 0) }}
            </tbody>
        </table>
        {{/* The rows of an archive are budgeted with archiveRows in main.go: keep both in step. */}}
        {{ if gt .MoreExtracted 0 }}<p class="more">… et {{ others .MoreExtracted " fichier de l'archive" " fichiers de l'archive" }}</p>{{ end }}
    </div>
    {{ end }}
    {{ if gt .MoreMitigatedArchives 0 }}<p class="more">… et {{ others .MoreMitigatedArchives " archive" " archives" }}</p>{{ end }}
</section>
{{ end }}

{{ if gt .NbFileNotAnalyzed 0 }}
<section id="not-analyzed-files">
    <h2 class="warn">Fichiers non analysés<span class="count">{{ .NbFileNotAnalyzed }}</span></h2>
    <p class="lead">Ces fichiers n'ont pas été analysés complètement : leur contenu n'a pas été vérifié. Total : {{ .NbFileNotAnalyzed }}.</p>
    <table>
        <colgroup><col style="width:36%"><col style="width:10%"><col style="width:30%"><col style="width:24%"></colgroup>
        <thead>
            <tr><th>Fichier</th><th>Taille</th><th>Raison</th><th>Archive d'origine</th></tr>
        </thead>
        <tbody>
            {{ range .NotAnalyzedFiles }}
            <tr><td class="fname">{{ .Name }}</td><td>{{ .Size }}</td><td>{{ .Reason }}</td><td class="muted">{{ .Origin }}</td></tr>
            {{ end }}
        </tbody>
    </table>
    {{ if gt .MoreNotAnalyzed 0 }}<p class="more">… et {{ others .MoreNotAnalyzed "" "" }}</p>{{ end }}
</section>
{{ end }}

{{ if gt (len .ErrorFiles) 0 }}
<section id="error-files">
    <h2 class="err">Fichiers en erreur<span class="count">{{ .TotalErrors }}</span></h2>
    <p class="lead">Les fichiers suivants n'ont pas pu être analysés correctement :</p>
    <table>
        <colgroup><col style="width:40%"><col style="width:60%"></colgroup>
        <thead>
            <tr><th>Fichier</th><th>Erreur</th></tr>
        </thead>
        <tbody>
            {{ range .ErrorFiles }}
            <tr><td class="fname">{{ .Name }}</td><td>{{ .Error }}</td></tr>
            {{ end }}
        </tbody>
    </table>
    {{ if gt .MoreErrorFiles 0 }}<p class="more">… et {{ others .MoreErrorFiles "" "" }}</p>{{ end }}
</section>
{{ end }}

</body>
</html>
