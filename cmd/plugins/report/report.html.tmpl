{{ define "findingHead" }}
{{ $name := index . 0 }}
{{ $link := index . 1 }}
        <colgroup><col style="width:46%"><col style="width:20%"><col style="width:18%"><col style="width:16%"></colgroup>
        <thead>
            <tr><th>{{ $name }} · SHA-256</th><th>Menace(s)</th><th>Raison · Taille</th><th>{{ $link }}</th></tr>
        </thead>
{{ end }}
{{ define "findingCells" }}
{{ $f := index . 0 }}
{{ $depth := index . 1 }}
    <td style="padding-left: {{ add 8 (mul (min $depth 6) 12) }}px;">
        <div class="fname">{{ if gt $depth 0 }}<span class="tree">↳</span> {{ end }}{{ $f.Name }}</div>
        <code>{{ $f.SHA256 }}</code>
    </td>
    <td>{{ range $f.Malwares }}<span class="pill">{{ . }}</span> {{ end }}</td>
    <td>{{ $f.MitigationReason }}<div class="sz">{{ $f.Size }}</div></td>
    {{ if eq $f.GMalwareURL "" }}
    <td class="muted">Pas d'analyse GLIMPS Malware</td>
    {{ else }}
    <td><a href="{{ $f.GMalwareURL }}">Lien analyse</a></td>
    {{ end }}
{{ end }}
{{ define "extractedFilesRows" }}
{{ $files := index . 0 }}
{{ $depth := index . 1 }}
{{ range $file := $files }}
<tr>
    {{ template "findingCells" (mergeArgsIntoSlice $file $depth) }}
</tr>
{{ if gt (len $file.ExtractedFiles) 0 }}
{{ template "extractedFilesRows" (mergeArgsIntoSlice $file.ExtractedFiles (add $depth 1)) }}
{{ end }}
{{ end }}
{{ end }}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Synthèse d'analyse - {{ .ScanID }}</title>
<style>
    :root {
        --red: #E52521;
        --red-text: #B91C1C;
        --orange: #EA5B0C;
        --orange-text: #B8470A;
        --amber: #FF8F00;
        --amber-text: #B45309;
        --ink: #1F2937;
        --muted: #6B7280;
        --line: #E5E7EB;
        --soft: #F7F7F8;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; line-height: 1.45; color: var(--ink); }
    .logo { background: linear-gradient(90deg, #E52521, #FAC003); border-radius: 50%; }
    .logo svg { display: block; }

    .top { display: flex; align-items: center; }
    .top .logo { width: 34px; height: 34px; }
    .top .who { margin-left: 10px; font-size: 15px; font-weight: bold; letter-spacing: 0.12em; }
    .top .who span { font-weight: normal; letter-spacing: 0.02em; color: var(--muted); }
    .top .when { margin-left: auto; text-align: right; font-size: 11px; color: var(--muted); }

    .verdict {
        margin-top: 14px;
        padding: 22px 26px;
        border-radius: 10px;
        color: #fff;
        background: linear-gradient(90deg, #B91C1C, #E52521);
        break-inside: avoid;
    }
    .verdict.ok { background: linear-gradient(90deg, #15803D, #22C55E); }
    .verdict.warn { background: linear-gradient(90deg, #B8470A, #EA5B0C); }
    .verdict .kicker { margin: 0; font-size: 11px; font-weight: bold; letter-spacing: 0.18em; text-transform: uppercase; }
    .verdict h1 { margin: 4px 0 6px; font-size: 26px; line-height: 1.15; }
    .verdict p { margin: 0; font-size: 13px; }
    .verdict p + p { margin-top: 4px; }
    .scan { margin: 8px 0 0; font-size: 11px; color: var(--muted); }

    .tiles { display: flex; margin-top: 14px; }
    .tile { flex: 1; margin-left: 10px; padding: 14px 12px 12px; border: 1px solid var(--line); border-top: 5px solid var(--line); border-radius: 8px; text-align: center; }
    .tile:first-child { margin-left: 0; }
    .tile .n { margin: 0; font-size: 38px; font-weight: bold; line-height: 1.05; }
    .tile .l { margin: 4px 0 0; font-size: 12px; font-weight: bold; color: var(--muted); }
    .tile.bad { border-top-color: var(--red); background: #FDF2F2; }
    .tile.bad .n { color: var(--red-text); }
    .tile.mal { border-top-color: #7F1D1D; background: #FDF2F2; }
    .tile.mal .n { color: #7F1D1D; }
    .tile.warn { border-top-color: var(--amber); background: #FFF8EC; }
    .tile.warn .n { color: var(--amber-text); }
    .tile.err { border-top-color: var(--muted); }
    .tile.err .n { color: var(--ink); }

    .facts { display: flex; margin-top: 12px; padding: 10px 6px; background: var(--soft); border-radius: 8px; }
    .fact { flex: 1; padding: 0 8px; }
    .fact .k { margin: 0; font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
    .fact .v { margin: 2px 0 0; font-size: 13px; font-weight: bold; }

    .note { margin: 12px 0 0; padding: 10px 14px; border-left: 5px solid var(--amber); background: #FFF8EC; border-radius: 0 6px 6px 0; break-inside: avoid; }

    section { margin-top: 24px; }
    h2 { margin: 0 0 10px; padding-bottom: 5px; border-bottom: 3px solid var(--orange); font-size: 17px; color: var(--ink); break-after: avoid; }
    h2 .count { margin-left: 8px; padding: 2px 9px; border-radius: 999px; font-size: 11px; color: #fff; background: var(--orange); vertical-align: middle; }
    h2.bad .count { background: var(--red); }
    h2.warn .count { background: var(--amber-text); }
    h2.err .count { background: var(--muted); }
    h3 { margin: 0 0 6px; font-size: 14px; color: var(--ink); break-after: avoid; }
    .lead { margin: 0 0 8px; color: var(--muted); }

    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 11.5px; line-height: 1.35; }
    thead th { padding: 6px 8px; text-align: left; font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); border-bottom: 2px solid var(--ink); }
    td { padding: 7px 8px; vertical-align: top; border-bottom: 1px solid var(--line); overflow-wrap: break-word; }
    tbody tr { break-inside: avoid; }
    .fname { font-weight: bold; overflow-wrap: break-word; }
    .sz { margin-top: 2px; color: var(--muted); }
    code { font-family: 'DejaVu Sans Mono', monospace; font-size: 8.5px; color: var(--muted); word-break: break-all; }
    .tree { color: var(--orange); }
    .pill { display: inline-block; margin: 0 2px 3px 0; padding: 2px 8px; border-radius: 999px; font-size: 10.5px; font-weight: bold; color: var(--red-text); background: #FDE8E8; overflow-wrap: break-word; }
    .muted { color: var(--muted); }
    a { color: var(--orange-text); font-weight: bold; }

    .archive { margin-top: 14px; padding: 12px 14px; border: 1px solid var(--line); border-left: 5px solid var(--red); border-radius: 8px; }
    .archive .meta { margin: 0 0 8px; font-size: 11.5px; color: var(--muted); overflow-wrap: break-word; }
    .archive .meta b { color: var(--ink); }
    .more { margin: 8px 0 0; font-style: italic; color: var(--muted); }
</style>
</head>
